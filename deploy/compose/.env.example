# Shoe Shop — local environment.
# Copy to `.env` (or run `task setup`) and customize as needed.
# Every value here has an inline default in the compose files, so the stack
# also runs with no .env at all.

# ── Image tags (pin these to exact releases for reproducibility) ──────
POSTGRES_TAG=16-alpine
REDIS_TAG=7-alpine
MEILI_TAG=v1.10
NATS_TAG=2.10-alpine
OTEL_LGTM_TAG=latest
ZITADEL_TAG=latest
PYROSCOPE_TAG=latest
WHOAMI_TAG=v1.10.2

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shoeshop
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Meilisearch ───────────────────────────────────────────────────────
MEILI_ENV=development
MEILI_MASTER_KEY=shoeshop-dev-master-key
MEILI_PORT=7700

# ── NATS ──────────────────────────────────────────────────────────────
NATS_PORT=4222
NATS_MON_PORT=8222

# ── Observability (Grafana / OTLP / Pyroscope) ───────────────────────
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PYROSCOPE_PORT=4040

# ── Zitadel auth (only used by the `full` profile) ───────────────────
# Masterkey MUST be exactly 32 characters.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_PORT=8080
