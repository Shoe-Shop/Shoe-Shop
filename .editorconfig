# EditorConfig — https://editorconfig.org
# Consistent formatting across every language in the monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go uses tabs (gofmt is non-negotiable).
[*.go]
indent_style = tab
indent_size = 4

# Makefiles require real tabs.
[{Makefile,*.mk}]
indent_style = tab

# Python — PEP 8.
[*.py]
indent_size = 4

# Rust — rustfmt default.
[*.rs]
indent_size = 4

# JVM languages.
[*.{java,kt,kts}]
indent_size = 4

# Web / config — 2 spaces.
[*.{ts,tsx,js,jsx,json,yaml,yml,toml,proto}]
indent_size = 2

# Markdown — preserve trailing whitespace (hard line breaks).
[*.md]
trim_trailing_whitespace = false

# Generated files — leave alone.
[*.{pb.go,_pb2.py}]
trim_trailing_whitespace = false
insert_final_newline = false
