# Shoe Shop — normalize line endings across a polyglot monorepo on mixed OSes.
# The reference dev box is Windows + WSL2; enforce LF everywhere so Docker
# builds, shell scripts, and Go/Rust/JVM tooling behave identically.

# Default: treat as text, normalize to LF in the repo, auto on checkout.
* text=auto eol=lf

# Scripts MUST be LF (CRLF breaks shebangs inside containers).
*.sh        text eol=lf
*.bash      text eol=lf
Taskfile.yml text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Windows-only scripts keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Source — explicit text, LF.
*.go        text eol=lf
*.rs        text eol=lf
*.java      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.sql       text eol=lf
*.proto     text eol=lf
*.md        text eol=lf

# Generated / vendored code — hide from language stats and diffs.
*.pb.go        linguist-generated=true
*_pb2.py       linguist-generated=true
*_pb2_grpc.py  linguist-generated=true
**/gen/**      linguist-generated=true
proto/**/*.go  linguist-generated=true

# Binary assets — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.onnx      binary
*.jar       binary
*.gz        binary
*.zip       binary
