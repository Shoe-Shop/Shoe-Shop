# ─────────────────────────────────────────────────────────────
# Shoe Shop — polyglot monorepo .gitignore
# ─────────────────────────────────────────────────────────────

# ── Local tooling state (Claude Code harness) ────────────────
.claude/

# ── Secrets & local env ──────────────────────────────────────
.env
.env.*
!.env.example
*.local
*.pem
*.key
!**/testdata/**/*.key
secrets/
.zitadel/

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.iml

# ── Logs & temp ──────────────────────────────────────────────
*.log
logs/
tmp/
.tmp/
*.pid

# ── Node / TypeScript (frontend, bff, cart) ──────────────────
node_modules/
.pnp.*
.yarn/*
dist/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/
.npm/
.pnpm-store/

# ── Go (catalogue, inventory, notification, tools) ───────────
bin/
*.exe
*.test
*.out
vendor/
go.work
go.work.sum

# ── Rust (payment) ───────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock.bak

# ── JVM (orders, shipping) ───────────────────────────────────
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
build/
.gradle/
.mvn/wrapper/maven-wrapper.jar

# ── Python (users, recommendation) ───────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.python-version

# ── Generated code ───────────────────────────────────────────
# protobuf/gRPC stubs under proto/gen/ ARE committed (Go in gen/go, Python in
# gen/python) — so the monorepo builds on a fresh clone with no codegen step.
# They are marked linguist-generated in .gitattributes. Regenerate with the
# commands in proto/README.md. Transient stubs generated elsewhere (e.g. inside
# a service tree during local dev) stay ignored.
**/*_pb2.py
**/*_pb2_grpc.py
!proto/gen/python/**/*_pb2.py
!proto/gen/python/**/*_pb2_grpc.py

# Ephemeral fault override written by the incident-simulator (env-knob inject).
deploy/compose/compose.incident.gen.yaml

# ── Observability / data volumes (local) ─────────────────────
deploy/compose/data/
**/pgdata/
**/.meili_data/

# ── Build & tooling caches ───────────────────────────────────
.task/
.cache/
sbom/
trivy-results.*
