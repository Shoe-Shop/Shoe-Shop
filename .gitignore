# ─────────────────────────────────────────────────────────────
# Shoe Shop — polyglot monorepo .gitignore
# ─────────────────────────────────────────────────────────────

# ── Secrets & local env ──────────────────────────────────────
.env
.env.*
!.env.example
*.local
*.pem
*.key
!**/testdata/**/*.key
secrets/
.zitadel/

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.iml

# ── Logs & temp ──────────────────────────────────────────────
*.log
logs/
tmp/
.tmp/
*.pid

# ── Node / TypeScript (frontend, bff, cart) ──────────────────
node_modules/
.pnp.*
.yarn/*
dist/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/
.npm/
.pnpm-store/

# ── Go (catalogue, inventory, notification, tools) ───────────
bin/
*.exe
*.test
*.out
vendor/
go.work
go.work.sum

# ── Rust (payment) ───────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock.bak

# ── JVM (orders, shipping) ───────────────────────────────────
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
build/
.gradle/
.mvn/wrapper/maven-wrapper.jar

# ── Python (users, recommendation) ───────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.python-version

# ── Generated protobuf / codegen ─────────────────────────────
**/gen/
proto/**/*.pb.go
**/*_pb2.py
**/*_pb2_grpc.py

# ── Observability / data volumes (local) ─────────────────────
deploy/compose/data/
**/pgdata/
**/.meili_data/

# ── Build & tooling caches ───────────────────────────────────
.task/
.cache/
sbom/
trivy-results.*
